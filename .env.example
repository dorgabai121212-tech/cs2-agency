# ===========================================================
#  סודות (מפתחות API וסיסמאות) — העתק לקובץ .env ומלא.
#  לעולם אל תשתף את קובץ .env ואל תעלה אותו ל-GitHub.
#  שדה ריק = הפלטפורמה לא מוגדרת (והצוות יעבוד במצב ניסיון עבורה).
# ===========================================================

# --- Claude (המוח של הצוות) ---
# מפתח מ- https://console.anthropic.com . בלי מפתח המערכת עובדת במצב הדגמה.
ANTHROPIC_API_KEY=
# חלופה למפתח: טוקן התחברות (השאר ריק אם יש מפתח)
ANTHROPIC_AUTH_TOKEN=
# 1 = לכפות מצב הדגמה (בלי קריאות ל-Claude) — שימושי לבדיקות
AGENCY_MOCK_LLM=

# --- יוטיוב / שורטס ---
# נתיב לקובץ client_secret.json שהורדת מ-Google Cloud Console (OAuth, אפליקציית Desktop)
YOUTUBE_CLIENT_SECRETS_FILE=

# --- טיקטוק ---
# טוקן גישה מ-TikTok for Developers (Content Posting API)
TIKTOK_ACCESS_TOKEN=

# --- מטא (אינסטגרם + פייסבוק) ---
# טוקן גישה ארוך-טווח מ-Meta for Developers
META_ACCESS_TOKEN=
# מזהה חשבון האינסטגרם העסקי/יוצר
IG_USER_ID=
# מזהה עמוד הפייסבוק
FB_PAGE_ID=

# --- X (טוויטר) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- רדיט ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- דיסקורד ---
# כתובת Webhook של הערוץ שלך בדיסקורד (הגדרות ערוץ ← אינטגרציות ← Webhooks)
DISCORD_WEBHOOK_URL=
