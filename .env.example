# ===========================================================
#  סודות (מפתחות וסיסמאות). הדרך הרגילה: חלון החיבור בלוח הבקרה (חיבורים),
#  שם המפתחות נשמרים בכספת של Windows (שירות cs2-agency) ולא בקובץ הזה.
#  הקובץ הזה הוא גיבוי למחשב בלי כספת, או למי שמעדיף קובץ (AGENCY_KEYRING=off).
#  מפתחות של הסטודיו הקיים (שירות cs2studio) נקראים משם לבד — אין צורך להעתיק.
#  לעולם אל תשתף את קובץ .env ואל תעלה אותו ל-GitHub.
#  שדה ריק = הפלטפורמה לא מוגדרת (והצוות יעבוד במצב אימון עבורה).
# ===========================================================

# --- Zernio (יוטיוב + Shorts + טיקטוק, הנתיב הרגיל) ---
# zernio.com ← Settings ← API Keys
ZERNIO_API_KEY=

# --- טלגרם (אישורים בלחיצה אחת, לא חובה) ---
# @BotFather ← /mybots ← הבוט שלך ← API Token
TELEGRAM_BOT_TOKEN=

# --- Claude (המוח של הצוות) ---
# מפתח מ- https://console.anthropic.com . בלי מפתח המערכת עובדת במצב הדגמה.
ANTHROPIC_API_KEY=
# חלופה למפתח: טוקן התחברות (השאר ריק אם יש מפתח)
ANTHROPIC_AUTH_TOKEN=
# 1 = לכפות מצב הדגמה (בלי קריאות ל-Claude) — שימושי לבדיקות
AGENCY_MOCK_LLM=

# --- יוטיוב ישירות (מתקדם; רק עם publishing.platforms.youtube.via: direct) ---
# נתיב לקובץ client_secret.json שהורדת מ-Google Cloud Console (OAuth, אפליקציית Desktop)
YOUTUBE_CLIENT_SECRETS_FILE=

# --- טיקטוק ישירות (מתקדם; רק עם publishing.platforms.tiktok.via: direct) ---
# טוקן גישה מ-TikTok for Developers (Content Posting API)
TIKTOK_ACCESS_TOKEN=

# --- מטא (אינסטגרם + פייסבוק) ---
# טוקן גישה ארוך-טווח מ-Meta for Developers
META_ACCESS_TOKEN=
# מזהה חשבון האינסטגרם העסקי/יוצר
IG_USER_ID=
# מזהה עמוד הפייסבוק
FB_PAGE_ID=

# --- X (טוויטר) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- רדיט ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- דיסקורד ---
# כתובת Webhook של הערוץ שלך בדיסקורד (הגדרות ערוץ ← אינטגרציות ← Webhooks)
DISCORD_WEBHOOK_URL=
